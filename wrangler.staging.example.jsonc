{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beads-catalog-staging",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-v2",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/admin", "/admin/*"],
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "beads-catalog-photos-staging",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beads-catalog-staging",
      // Substitua pelo ID do banco D1 de homologação antes de usar --remote.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./worker/d1/migrations",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
